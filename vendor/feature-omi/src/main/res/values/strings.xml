    <!-- Card -->
    <string name="omi_error_nearby_permission">Nearby devices access is needed to link the pendant.</string>
    <string name="omi_intro">Record from an Omi you wear. A tap on the pendant starts a recording, confirmed by one short vibration; another tap stops it, with two.</string>
    <string name="omi_intro_disconnect_app">Disconnect the pendant from the Omi app first: that app sends its audio to its own service, and the pendant takes one connection at a time.</string>
    <string name="omi_pairing_unsupported">This phone cannot associate companion devices</string>
    <string name="omi_pairing_not_found">No pendant found</string>
    <string name="omi_looking">Looking for the pendant…</string>
    <string name="omi_link">Link an Omi</string>
    <string name="omi_capture_all_day">Capture all day</string>
    <string name="omi_capture_all_day_description">Every conversation the pendant hears is recorded, one recording per conversation. A tap marks a moment: about 30 seconds before it and what follows, up to the next pause, are saved as a note.</string>
    <string name="omi_details">Details</string>
    <string name="omi_forget">Forget this pendant</string>
    <string name="omi_link_encrypted">Encrypted link</string>
    <string name="omi_link_not_encrypted">Link not encrypted</string>
    <string name="omi_detail_not_encrypted">The link is not encrypted: pairing did not complete. Forget the pendant and link it again.</string>
    <string name="omi_detail_capturing">Capturing all day. Tap the pendant to mark a moment.</string>
    <string name="omi_detail_tap_mute">Tap the pendant to start or stop a recording. Between recordings its microphone is off.</string>
    <string name="omi_detail_tap_no_mute">Tap the pendant to start or stop a recording. Its firmware cannot switch the microphone off: while linked it discards what it hears, but away from the phone it keeps audio on itself. Update the firmware to turn the microphone off between recordings.</string>
    <string name="omi_detail_connecting">Linking and checking the pendant.</string>
    <string name="omi_detail_disconnected">Switch the pendant on or bring it closer. It links again on its own.</string>
    <!-- %1$s: the audio codec the firmware reports, or omi_codec_unknown -->
