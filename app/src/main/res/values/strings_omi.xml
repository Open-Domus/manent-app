    <!-- Pairing -->
    <string name="omi_error_nearby_permission">Manent needs the Nearby devices permission to link the pendant.</string>
    <string name="omi_intro">Record with an Omi worn around your neck. Tap the pendant once to start recording (one short buzz), tap again to stop (two buzzes).</string>
    <string name="omi_intro_disconnect_app">First unlink the pendant from the Omi app. The pendant talks to one phone app at a time, and that app sends the audio to its own servers.</string>
    <string name="omi_pairing_unsupported">This phone does not support linking companion devices</string>
    <string name="omi_pairing_not_found">No pendant found</string>
    <string name="omi_looking">Looking for the pendant…</string>
    <string name="omi_link">Link an Omi</string>

    <!-- Card -->
    <string name="omi_capture_all_day">Capture all day</string>
    <string name="omi_capture_all_day_description">Records each conversation the pendant hears as its own recording. Tap the pendant to keep a moment as a note: roughly the last 30 seconds plus whatever follows, until the next pause.</string>
    <string name="omi_details">Details</string>
    <string name="omi_forget">Forget this pendant</string>
    <string name="omi_link_encrypted">Encrypted link</string>
    <string name="omi_link_not_encrypted">Link not encrypted</string>
    <string name="omi_detail_not_encrypted">Pairing did not finish, so the link is not encrypted. Forget the pendant and link it again.</string>
    <string name="omi_detail_capturing">Capturing all day. Tap the pendant to mark a moment.</string>
    <string name="omi_detail_tap_mute">Tap the pendant to start or stop recording. Its microphone stays off in between.</string>
    <string name="omi_detail_tap_no_mute">Tap the pendant to start or stop recording. This firmware cannot turn the microphone off: near the phone the pendant throws away what it hears, but out of range it stores audio on itself. Update the firmware so the microphone switches off between recordings.</string>
    <string name="omi_detail_connecting">Connecting to the pendant and checking it.</string>
    <string name="omi_detail_disconnected">Turn the pendant on or move it closer. It reconnects by itself.</string>
    <!-- %1$s: the firmware's audio codec number, or omi_codec_unknown -->
    <string name="omi_detail_unsupported">The pendant\'s firmware sends audio in a format Manent cannot read (codec %1$s). Update the firmware.</string>
