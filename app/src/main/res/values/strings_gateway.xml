<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Omnesis card on Home -->
    <string name="gateway_card_title">Omnesis gateway</string>

    <!-- Pairing screen -->
    <string name="gateway_pair_command" translatable="false">omnesis devices pair --kind android --scopes read,write:omnesis-recordings,write:omnesis-notes</string>
    <string name="gateway_pair_payload_hint">Paste the JSON the command prints.</string>
    <string name="gateway_pairing">Pairing…</string>
    <!-- %1$s: why pairing failed -->
    <string name="gateway_pair_failed">Pairing failed: %1$s</string>

    <!-- What is wrong with a payload or the fields typed by hand -->
    <string name="gateway_problem_not_json">This is not a pairing payload: it is not valid JSON.</string>
    <string name="gateway_problem_missing_version">The payload has no version field \"v\".</string>
    <!-- %1$s: the version the payload declares -->
    <string name="gateway_problem_unsupported_version">Pairing version %1$s is not supported. Update the gateway and try again.</string>
    <!-- %1$s: the name of the missing field, as it appears in the payload -->
    <string name="gateway_problem_missing_field">Missing field: %1$s</string>
    <string name="gateway_problem_missing_code">Enter the pairing code.</string>
    <string name="gateway_problem_not_https">The gateway URL must start with https://.</string>
    <string name="gateway_problem_invalid_url">The gateway URL is not valid.</string>
    <string name="gateway_problem_system_origin">With system trust the gateway URL must be only https:// and a host, with no path.</string>
    <string name="gateway_problem_invalid_fingerprint">The fingerprint must be 64 hexadecimal characters, without colons.</string>
    <string name="gateway_problem_invalid_tls_mode">The payload names an unknown TLS trust mode.</string>
    <!-- %1$s: the trust mode from the payload -->
    <string name="gateway_problem_unsupported_tls_mode">Manent does not support the TLS trust mode \"%1$s\".</string>

    <!-- Short reasons a gateway call failed, shown after "Not reachable:" or "Pairing failed:" -->
    <string name="gateway_error_unauthorized">unauthorized</string>
    <string name="gateway_error_forbidden">access refused</string>
    <string name="gateway_error_not_found">not found</string>
    <!-- %1$d: the HTTP status code -->
    <string name="gateway_error_server">the gateway answered %1$d</string>
    <string name="gateway_error_decoding">unexpected reply</string>

    <!-- Pairing screen sections -->
    <string name="gateway_pair_payload_label">From the gateway</string>
    <string name="gateway_pair_payload_title">One command, then paste</string>
    <string name="gateway_pair_manual_title">Address and code</string>
    <string name="gateway_pair_not_saved">The gateway accepted the phone, but the phone could not store the credential securely. Try again; if it keeps failing, restart the phone.</string>
