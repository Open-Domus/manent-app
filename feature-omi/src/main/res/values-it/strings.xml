    <!-- Card -->
    <string name="omi_error_nearby_permission">Per associare il ciondolo serve l\'accesso ai dispositivi nelle vicinanze.</string>
    <string name="omi_intro">Registra con un Omi che indossi. Un tocco sul ciondolo avvia una registrazione, confermata da una breve vibrazione; un altro tocco la interrompe, con due vibrazioni.</string>
    <string name="omi_intro_disconnect_app">Prima scollega il ciondolo dall\'app Omi: quell\'app invia l\'audio al proprio servizio e il ciondolo accetta una sola connessione alla volta.</string>
    <string name="omi_pairing_unsupported">Questo telefono non può associare dispositivi companion</string>
    <string name="omi_pairing_not_found">Nessun ciondolo trovato</string>
    <string name="omi_looking">Ricerca del ciondolo…</string>
    <string name="omi_link">Associa un Omi</string>
    <string name="omi_capture_all_day">Registra tutto il giorno</string>
    <string name="omi_capture_all_day_description">Ogni conversazione che il ciondolo sente viene registrata, una registrazione per conversazione. Un tocco segna un momento: circa 30 secondi prima e quello che segue, fino alla pausa successiva, vengono salvati come nota.</string>
    <string name="omi_details">Dettagli</string>
    <string name="omi_forget">Dimentica questo ciondolo</string>
    <string name="omi_link_encrypted">Collegamento crittografato</string>
    <string name="omi_link_not_encrypted">Collegamento non crittografato</string>
    <string name="omi_detail_not_encrypted">Il collegamento non è crittografato: l\'associazione non è stata completata. Dimentica il ciondolo e associalo di nuovo.</string>
    <string name="omi_detail_capturing">Registrazione per tutto il giorno. Tocca il ciondolo per segnare un momento.</string>
    <string name="omi_detail_tap_mute">Tocca il ciondolo per avviare o interrompere una registrazione. Tra una registrazione e l\'altra il microfono è spento.</string>
    <string name="omi_detail_tap_no_mute">Tocca il ciondolo per avviare o interrompere una registrazione. Il suo firmware non può spegnere il microfono: quando è collegato scarta ciò che sente, ma lontano dal telefono conserva l\'audio in memoria. Aggiorna il firmware per spegnere il microfono tra una registrazione e l\'altra.</string>
    <string name="omi_detail_connecting">Collegamento e verifica del ciondolo in corso.</string>
    <string name="omi_detail_disconnected">Accendi il ciondolo o avvicinalo. Si ricollega da solo.</string>
    <string name="omi_detail_unsupported">Il firmware di questo ciondolo invia l\'audio in un formato che Omnesis non legge (%1$s). Aggiorna il firmware.</string>
    <string name="omi_codec_unknown">sconosciuto</string>
